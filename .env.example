# Contact form email delivery (Resend). Without these, development logs submissions and
# production shows a friendly "email us at info@growdigital.com" fallback.
RESEND_API_KEY=
# Comma-separated recipient list
CONTACT_TO=info@growdigital.com
# Verified sender in Resend
CONTACT_FROM="Grow Digital Website <website@growdigital.com>"

# SEO / analytics (all optional)
# Google Search Console HTML-tag verification token (content value only)
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification token (msvalidate.01)
BING_SITE_VERIFICATION=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (GA loads only when set)
NEXT_PUBLIC_GA_ID=
